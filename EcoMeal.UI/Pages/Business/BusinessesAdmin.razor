@page "/admin/businesses"
@using EcoMeal.Shared.DTOs.BusinessDTOs
@using EcoMeal.Shared.DTOs.BusinessTypeDTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using System.IO
@inject HttpClient Http

<PageTitle>Admin - Businesses</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0">Business Management</h1>
            <p class="text-muted">Review, approve, edit, and manage all businesses.</p>
        </div>
        <button class="btn btn-primary shadow-sm fw-bold" @onclick="() => ShowPopup(new BusinessGetDTO())">
            <i class="bi bi-plus-lg me-2"></i> Add New Business
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Approval Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var filter in new[] { "All", "Approved", "Pending Approval" })
        {
            var count = filter == "All" ? businesses.Count : (filter == "Approved" ? businesses.Count(b => b.IsApproved) : businesses.Count(b => !b.IsApproved));
            <button class="btn btn-sm @(selectedApprovalFilter == filter ? "btn-primary fw-bold" : "btn-outline-secondary")"
                    @onclick="() => selectedApprovalFilter = filter">
                @filter (@count)
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        var filteredBusinesses = businesses.Where(b =>
            selectedApprovalFilter == "All" ||
            (selectedApprovalFilter == "Approved" && b.IsApproved) ||
            (selectedApprovalFilter == "Pending Approval" && !b.IsApproved)
        ).ToList();

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Address</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in filteredBusinesses)
                            {
                                <tr>
                                    <td style="width: 80px;">
                                        @if (!string.IsNullOrWhiteSpace(b.ImageUrl))
                                        {
                                            <img src="@b.ImageUrl" alt="img" class="rounded"
                                                 style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px;">
                                                <i class="bi bi-shop"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-bold">@b.Name</td>
                                    <td class="text-muted">
                                        @(businessTypes.FirstOrDefault(bt => bt.Id == b.BusinessTypeId)?.Name ?? "Unknown")
                                    </td>
                                    <td>@b.Address</td>
                                    <td>
                                        @if (b.IsApproved)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill fw-semibold">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending Approval
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!b.IsApproved)
                                        {
                                            <button class="btn btn-sm btn-success me-2 fw-bold" @onclick="() => ToggleApproval(b, true)">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-warning me-2" @onclick="() => ToggleApproval(b, false)">
                                                <i class="bi bi-x-circle me-1"></i> Revoke
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => ShowPopup(b)">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBusiness(b.Id)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!filteredBusinesses.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No businesses found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (isPopupVisible && editModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(isNew ? "Add Business" : "Edit Business")</h5>
                    <button type="button" class="btn-close" @onclick="ClosePopup"></button>
                </div>

                <EditForm Model="@editModel" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator></DataAnnotationsValidator>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Business Name</label>
                                <InputText @bind-Value="editModel.Name" class="form-control"
                                           placeholder="e.g., Green Bite Bistro" />
                                <ValidationMessage For="@(() => editModel.Name)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Business Type</label>
                                <InputSelect @bind-Value="editModel.BusinessTypeId" class="form-select">
                                    <option value="@Guid.Empty">-- Select type --</option>
                                    @foreach (var bt in businessTypes)
                                    {
                                        <option value="@bt.Id">@bt.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => editModel.BusinessTypeId)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Address</label>
                            <InputText @bind-Value="editModel.Address" class="form-control"
                                       placeholder="Street name and number..." />
                            <ValidationMessage For="@(() => editModel.Address)" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Latitude</label>
                                <InputNumber @bind-Value="editModel.Latitude" class="form-control" placeholder="44.3302" step="0.0001" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Longitude</label>
                                <InputNumber @bind-Value="editModel.Longitude" class="form-control" placeholder="23.7949" step="0.0001" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Description</label>
                            <InputTextArea @bind-Value="editModel.Description" class="form-control" rows="3"
                                           placeholder="Optional description..." />
                            <ValidationMessage For="@(() => editModel.Description)" />
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="editModel.IsApproved" class="form-check-input" id="isApprovedCheck" />
                            <label class="form-check-label fw-bold" for="isApprovedCheck">
                                Approved (Visible in Shop)
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Image (Upload file or paste URL)</label>

                            @if (!string.IsNullOrWhiteSpace(editModel.ImageUrl))
                            {
                                <div class="mb-2 text-center">
                                    <img src="@editModel.ImageUrl" alt="Preview" class="img-thumbnail shadow-sm"
                                         style="max-height: 160px; object-fit: cover;" />
                                </div>
                            }

                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                <InputText @bind-Value="editModel.ImageUrl" class="form-control"
                                           placeholder="Paste image URL here (https://)..." />
                            </div>

                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upload"></i></span>
                                <InputFile OnChange="LoadFiles" class="form-control"
                                           accept="image/png, image/jpeg, image/webp" />
                            </div>

                            <ValidationMessage For="@(() => editModel.ImageUrl)" />
                            <small class="text-muted">You can either paste a direct link or upload an image from your device (Max 5MB).</small>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePopup">Cancel</button>
                        <button type="submit" class="btn btn-success fw-bold" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg me-1"></i> <span>Save</span>
                            }
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<BusinessGetDTO> businesses = new List<BusinessGetDTO>();
    private List<BusinessTypeGetDTO> businessTypes = new List<BusinessTypeGetDTO>();

    private BusinessUpdateDTO? editModel;

    private bool isPopupVisible = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;
    private string selectedApprovalFilter = "All";

    private bool isNew => editModel?.Id == Guid.Empty;

    private long maxFileSize = 1024 * 1024 * 5;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            businessTypes = await Http.GetFromJsonAsync<List<BusinessTypeGetDTO>>("api/businesstypes") ?? new List<BusinessTypeGetDTO>();
            businesses = await Http.GetFromJsonAsync<List<BusinessGetDTO>>("api/businesses") ?? new List<BusinessGetDTO>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleApproval(BusinessGetDTO b, bool approve)
    {
        errorMessage = null;
        try
        {
            var response = await Http.PutAsync($"api/businesses/{b.Id}/approve?isApproved={approve}", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating approval: {ex.Message}";
        }
    }

    private void ShowPopup(BusinessGetDTO b)
    {
        editModel = new BusinessUpdateDTO
        {
            Id = b.Id,
            UserId = b.UserId,
            Name = b.Name,
            Address = b.Address,
            Description = b.Description,
            ImageUrl = b.ImageUrl,
            BusinessTypeId = b.BusinessTypeId,
            IsApproved = b.IsApproved,
            Latitude = b.Latitude,
            Longitude = b.Longitude
        };

        isPopupVisible = true;
    }

    private void ClosePopup()
    {
        isPopupVisible = false;
        editModel = null;
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var imageBytes = memoryStream.ToArray();

                var base64String = Convert.ToBase64String(imageBytes);
                var format = file.ContentType;

                if (editModel != null)
                {
                    editModel.ImageUrl = $"data:{format};base64,{base64String}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error uploading file: {ex.Message}";
            }
        }
    }

    private async Task OnValidSubmit()
    {
        if (editModel == null || editModel.BusinessTypeId == Guid.Empty) return;

        editModel.Name = editModel.Name?.Trim() ?? string.Empty;
        editModel.Address = editModel.Address?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(editModel.Description))
            editModel.Description = null;
        else
            editModel.Description = editModel.Description.Trim();

        if (string.IsNullOrWhiteSpace(editModel.ImageUrl))
            editModel.ImageUrl = null;
        else
            editModel.ImageUrl = editModel.ImageUrl.Trim();

        isSaving = true;
        errorMessage = null;
        try
        {
            if (isNew)
            {
                var createDto = new BusinessCreateDTO
                {
                    Name = editModel.Name,
                    Address = editModel.Address,
                    Description = editModel.Description,
                    ImageUrl = editModel.ImageUrl,
                    BusinessTypeId = editModel.BusinessTypeId,
                    IsApproved = editModel.IsApproved,
                    Latitude = editModel.Latitude,
                    Longitude = editModel.Longitude
                };

                var response = await Http.PostAsJsonAsync("api/businesses/create", createDto);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await response.Content.ReadAsStringAsync();
                    return;
                }
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"api/businesses/{editModel.Id}", editModel);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = await response.Content.ReadAsStringAsync();
                    return;
                }
            }

            await LoadDataAsync();
            ClosePopup();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving data: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteBusiness(Guid id)
    {
        errorMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"api/businesses/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadDataAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting data: {ex.Message}";
        }
    }
}