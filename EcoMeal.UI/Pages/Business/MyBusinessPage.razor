@page "/business/dashboard"
@using EcoMeal.Shared.DTOs.PackageDTOs
@using EcoMeal.Shared.DTOs.BusinessDTOs
@using EcoMeal.Shared.DTOs.PackageTypeDTOs
@using EcoMeal.Shared.DTOs.BusinessTypeDTOs
@using EcoMeal.Shared.DTOs.OrderDTOs
@using EcoMeal.Shared.DTOs.OrderPackageDTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Business")]
@inject HttpClient Http

<PageTitle>My Business Dashboard</PageTitle>

<div class="container-fluid mt-4">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (myBusiness == null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0 rounded-3 border-top border-warning border-4 mt-5">
                    <div class="card-body p-5 text-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-4"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-shop fs-1"></i>
                        </div>
                        <h2 class="fw-bold mb-3">Welcome to EcoMeal!</h2>
                        <p class="text-muted mb-4">Before you can start adding food packages, you need to set up your
                            business profile.</p>

                            <button class="btn btn-warning btn-lg fw-bold px-5" @onclick="ShowBusinessSetup">
                                <i class="bi bi-gear-fill me-2"></i> Setup My Business
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    else
        {
            @if (!myBusiness.IsApproved)
            {
                <div class="alert alert-warning border-warning shadow-sm mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-clock-history fs-3 text-warning me-3"></i>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Business Pending Approval</h5>
                        <p class="mb-0 small">
                            Your business profile has been registered and is currently waiting for administrator approval.
                            Once approved, your business and its active packages will automatically become visible to customers in the Shop.
                        </p>
                    </div>
                </div>
            }

            <div class="row mb-4 align-items-center">
                <div class="col">
                    <div class="d-flex align-items-center gap-3">
                        <h1 class="fw-bold mb-0">Dashboard</h1>
                        @if (myBusiness.IsApproved)
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i>Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill fw-semibold">
                                <i class="bi bi-hourglass-split me-1"></i>Pending Approval
                            </span>
                        }
                    </div>
                    <p class="text-muted mt-1">Manage your business profile, packages, and incoming orders.</p>
                </div>
            </div>

            <div class="row">
                <!-- Left Side: Business Details -->
                <div class="col-lg-4 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        @if (!string.IsNullOrEmpty(myBusiness.ImageUrl))
                        {
                            <img src="@myBusiness.ImageUrl" class="card-img-top" alt="Business Image"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light text-center py-5">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h4 class="fw-bold">@myBusiness.Name</h4>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @myBusiness.Address
                            </p>
                            <p class="card-text">@myBusiness.Description</p>

                            <hr />
                            <button class="btn btn-outline-secondary w-100 fw-bold" @onclick="EditBusinessProfile">
                                <i class="bi bi-pencil-square me-2"></i> Edit Profile
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Tabs for Packages & Orders -->
                <div class="col-lg-8 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom pt-3 pb-0">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <ul class="nav nav-tabs border-bottom-0">
                                    <li class="nav-item">
                                        <button class="nav-link fw-bold @(activeTab == "packages" ? "active text-warning border-bottom border-warning border-3" : "text-muted")"
                                                @onclick='() => activeTab = "packages"'>
                                            <i class="bi bi-box-seam me-1"></i> My Packages
                                            <span class="badge bg-secondary ms-1">@myPackages.Count</span>
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link fw-bold @(activeTab == "orders" ? "active text-warning border-bottom border-warning border-3" : "text-muted")"
                                                @onclick='() => activeTab = "orders"'>
                                            <i class="bi bi-receipt me-1"></i> Orders
                                            <span class="badge @(myOrders.Any(o => o.StatusName == "Pending") ? "bg-warning text-dark" : "bg-secondary") ms-1">
                                                @myOrders.Count
                                            </span>
                                        </button>
                                    </li>
                                </ul>

                                @if (activeTab == "packages")
                                {
                                    <button class="btn btn-warning fw-bold btn-sm"
                                            @onclick="() => ShowPackagePopup(new PackageGetDTO { PickupStart = DateTime.Today.AddHours(10), PickupEnd = DateTime.Today.AddHours(18) })">
                                        <i class="bi bi-plus-lg me-1"></i> Add Package
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            @if (activeTab == "packages")
                            {
                                @if (!myPackages.Any())
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                        <h5>No packages yet</h5>
                                        <p>Start adding surplus food to save it from waste!</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Image</th>
                                                    <th>Package Name</th>
                                                    <th>Price</th>
                                                    <th>Qty</th>
                                                    <th>Pickup Time</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var pkg in myPackages)
                                                {
                                                    <tr>
                                                        <td>
                                                            <img src="@pkg.ImageUrl" alt="img" class="rounded"
                                                                 style="width: 40px; height: 40px; object-fit: cover;" />
                                                        </td>
                                                        <td class="fw-bold">@pkg.Name</td>
                                                        <td class="text-success fw-bold">@pkg.Price.ToString("0.00") RON</td>
                                                        <td><span class="badge bg-secondary">@pkg.Quantity</span></td>
                                                        <td class="small text-muted">
                                                            @pkg.PickupStart.ToString("HH:mm") - @pkg.PickupEnd.ToString("HH:mm")
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-sm btn-light me-2"
                                                                    @onclick="() => ShowPackagePopup(pkg)">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick="() => DeletePackage(pkg.Id)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                            else if (activeTab == "orders")
                            {
                                <!-- Status Filter Pills -->
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @foreach (var filter in new[] { "All", "Pending", "Confirmed", "Completed", "Cancelled" })
                                    {
                                        var count = filter == "All" ? myOrders.Count : myOrders.Count(o => o.StatusName == filter);
                                        <button class="btn btn-sm @(selectedStatusFilter == filter ? "btn-warning fw-bold" : "btn-outline-secondary")"
                                                @onclick="() => selectedStatusFilter = filter">
                                            @filter (@count)
                                        </button>
                                    }
                                </div>

                                var filteredOrders = selectedStatusFilter == "All"
                                    ? myOrders
                                    : myOrders.Where(o => o.StatusName == selectedStatusFilter).ToList();

                                @if (!filteredOrders.Any())
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-receipt-cutoff fs-1 d-block mb-3"></i>
                                        <h5>No orders found</h5>
                                        <p class="small">@(selectedStatusFilter == "All" ? "You haven't received any orders yet." : $"No {selectedStatusFilter} orders at the moment.")</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-3">
                                        @foreach (var order in filteredOrders)
                                        {
                                            <div class="card border shadow-sm rounded-3">
                                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                                    <div>
                                                        <span class="fw-bold fs-6">Order #@order.OrderNumber</span>
                                                    </div>
                                                    <div>
                                                        <span class="badge px-3 py-2 rounded-pill fw-semibold @GetStatusBadgeClass(order.StatusName)">
                                                            @order.StatusName
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="card-body p-3">
                                                    <ul class="list-group list-group-flush mb-2">
                                                        @foreach (var item in order.OrderPackages)
                                                        {
                                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1 border-0 bg-transparent">
                                                                <div>
                                                                    <span class="fw-semibold text-dark">@item.PackageName</span>
                                                                    <span class="badge bg-secondary ms-2">x @item.Quantity</span>
                                                                </div>
                                                                <div class="text-muted small">
                                                                    <i class="bi bi-clock me-1"></i>@item.PickupStart.ToString("HH:mm") - @item.PickupEnd.ToString("HH:mm")
                                                                </div>
                                                                <div class="fw-bold text-dark">
                                                                    @((item.PackagePrice * item.Quantity).ToString("0.00")) RON
                                                                </div>
                                                            </li>
                                                        }
                                                    </ul>
                                                    <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold text-muted small">Total:</span>
                                                        <span class="fw-bold text-success fs-6">
                                                            @((order.OrderPackages.Sum(op => op.PackagePrice * op.Quantity)).ToString("0.00")) RON
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2">
                                                    <span class="text-muted small">Status Management:</span>
                                                    <div class="d-flex gap-2">
                                                        @if (order.StatusName == "Pending")
                                                        {
                                                            <button class="btn btn-sm btn-success fw-bold"
                                                                    @onclick='() => ChangeOrderStatus(order, "Confirmed")'
                                                                    disabled="@isUpdatingOrder">
                                                                <i class="bi bi-check-lg me-1"></i> Confirm
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick='() => ChangeOrderStatus(order, "Cancelled")'
                                                                    disabled="@isUpdatingOrder">
                                                                <i class="bi bi-x-lg me-1"></i> Reject
                                                            </button>
                                                        }
                                                        else if (order.StatusName == "Confirmed")
                                                        {
                                                            <button class="btn btn-sm btn-primary fw-bold"
                                                                    @onclick='() => ChangeOrderStatus(order, "Completed")'
                                                                    disabled="@isUpdatingOrder">
                                                                <i class="bi bi-bag-check-fill me-1"></i> Mark Completed
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick='() => ChangeOrderStatus(order, "Cancelled")'
                                                                    disabled="@isUpdatingOrder">
                                                                <i class="bi bi-x-lg me-1"></i> Cancel
                                                            </button>
                                                        }
                                                        else if (order.StatusName == "Completed")
                                                        {
                                                            <span class="text-success small fw-semibold d-flex align-items-center">
                                                                <i class="bi bi-check-circle-fill me-1"></i> Order Completed
                                                            </span>
                                                        }
                                                        else if (order.StatusName == "Cancelled")
                                                        {
                                                            <span class="text-danger small fw-semibold d-flex align-items-center">
                                                                <i class="bi bi-x-circle-fill me-1"></i> Order Cancelled
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (isBusinessPopupVisible && businessEditModel != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning bg-opacity-10">
                        <h5 class="modal-title fw-bold">@(myBusiness == null ? "Setup Business Profile" : "Edit Business Profile")</h5>
                        <button type="button" class="btn-close" @onclick="CloseBusinessPopup"></button>
                    </div>
                    <EditForm Model="@businessEditModel" OnValidSubmit="SaveBusinessProfile">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Business Name</label>
                                <InputText @bind-Value="businessEditModel.Name" class="form-control" />
                                <ValidationMessage For="@(() => businessEditModel.Name)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Business Type</label>
                                <InputSelect @bind-Value="businessEditModel.BusinessTypeId" class="form-select">
                                    <option value="@Guid.Empty">-- Select type --</option>
                                    @foreach (var type in businessTypes)
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => businessEditModel.BusinessTypeId)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Address</label>
                                <InputText @bind-Value="businessEditModel.Address" class="form-control" />
                                <ValidationMessage For="@(() => businessEditModel.Address)" />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Latitude (e.g. 44.3302)</label>
                                    <InputNumber @bind-Value="businessEditModel.Latitude" class="form-control" placeholder="44.3302" step="0.0001" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Longitude (e.g. 23.7949)</label>
                                    <InputNumber @bind-Value="businessEditModel.Longitude" class="form-control" placeholder="23.7949" step="0.0001" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <InputTextArea @bind-Value="businessEditModel.Description" class="form-control" rows="3" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Image URL</label>
                                <InputText @bind-Value="businessEditModel.ImageUrl" class="form-control"
                                           placeholder="https://..." />
                            </div>
                        </div>
                        <div class="modal-footer">
                            @if (myBusiness != null)
                            {
                                <button type="button" class="btn btn-secondary" @onclick="CloseBusinessPopup">Cancel</button>
                            }
                            <button type="submit" class="btn btn-warning fw-bold" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save Profile")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (isPackagePopupVisible && packageEditModel != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">@(packageEditModel.Id == Guid.Empty ? "Add New Package" : "Edit Package")</h5>
                        <button type="button" class="btn-close" @onclick="ClosePackagePopup"></button>
                    </div>
                    <EditForm Model="@packageEditModel" OnValidSubmit="SavePackage">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Package Name</label>
                                    <InputText @bind-Value="packageEditModel.Name" class="form-control" />
                                    <ValidationMessage For="@(() => packageEditModel.Name)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Package Type</label>
                                    <InputSelect @bind-Value="packageEditModel.PackageTypeId" class="form-select">
                                        <option value="@Guid.Empty">-- Select type --</option>
                                        @foreach (var pt in packageTypes)
                                        {
                                            <option value="@pt.Id">@pt.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => packageEditModel.PackageTypeId)" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-bold">Price</label>
                                    <InputNumber @bind-Value="packageEditModel.Price" class="form-control" />
                                    <ValidationMessage For="@(() => packageEditModel.Price)" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-bold">Qty</label>
                                    <InputNumber @bind-Value="packageEditModel.Quantity" class="form-control" />
                                    <ValidationMessage For="@(() => packageEditModel.Quantity)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Image URL</label>
                                    <InputText @bind-Value="packageEditModel.ImageUrl" class="form-control" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Pickup Start</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="packageEditModel.PickupStart"
                                               class="form-control" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Pickup End</label>
                                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="packageEditModel.PickupEnd"
                                               class="form-control" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Description</label>
                                <InputTextArea @bind-Value="packageEditModel.Description" class="form-control" rows="2" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="ClosePackagePopup">Cancel</button>
                            <button type="submit" class="btn btn-warning fw-bold" disabled="@isSaving">Save Package</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isUpdatingOrder = false;

    // Tabs & Filters
    private string activeTab = "packages";
    private string selectedStatusFilter = "All";

    // Business Data
    private BusinessGetDTO? myBusiness;
    private List<PackageGetDTO> myPackages = new List<PackageGetDTO>();
    private List<OrderGetDTO> myOrders = new List<OrderGetDTO>();

    // Helper Dropdown Lists
    private List<BusinessTypeGetDTO> businessTypes = new List<BusinessTypeGetDTO>();
    private List<PackageTypeGetDTO> packageTypes = new List<PackageTypeGetDTO>();

    // Form Models
    private BusinessUpdateDTO? businessEditModel;
    private PackageUpdateDTO? packageEditModel;

    // Modal Visibility
    private bool isBusinessPopupVisible = false;
    private bool isPackagePopupVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        try
        {
            businessTypes = await Http.GetFromJsonAsync<List<BusinessTypeGetDTO>>("api/businesstypes") ?? new List<BusinessTypeGetDTO>();
            packageTypes = await Http.GetFromJsonAsync<List<PackageTypeGetDTO>>("api/packagetypes") ?? new List<PackageTypeGetDTO>();

            myBusiness = await Http.GetFromJsonAsync<BusinessGetDTO>("api/businesses/my-business");

            if (myBusiness != null)
            {
                var allPackages = await Http.GetFromJsonAsync<List<PackageGetDTO>>("api/packages");
                myPackages = allPackages?.Where(p => p.BusinessId == myBusiness.Id).ToList() ?? new List<PackageGetDTO>();

                var allOrders = await Http.GetFromJsonAsync<List<OrderGetDTO>>("api/orders");
                myOrders = allOrders?.Where(o => o.BusinessId == myBusiness.Id).OrderByDescending(o => o.OrderNumber).ToList() ?? new List<OrderGetDTO>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeOrderStatus(OrderGetDTO order, string newStatus)
    {
        isUpdatingOrder = true;
        try
        {
            var statusId = newStatus switch
            {
                "Pending" => Guid.Parse("E2712CD8-CD80-4F27-9711-C676F84E339C"),
                "Confirmed" => Guid.Parse("45B77ECA-EFE4-4A2E-867D-7EB6170D3703"),
                "Completed" => Guid.Parse("24FEB601-B7FA-4E23-AA03-F121FAD19347"),
                "Cancelled" => Guid.Parse("224F9B84-E878-4B04-BFB9-6BC6B3EBA8DD"),
                _ => Guid.Empty
            };

            if (statusId == Guid.Empty) return;

            var updateDto = new OrderUpdateDTO
            {
                Id = order.Id,
                UserId = order.UserId,
                BusinessId = order.BusinessId,
                StatusId = statusId,
                OrderNumber = order.OrderNumber
            };

            var response = await Http.PutAsJsonAsync($"api/orders/{order.Id}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                await LoadDashboardData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error updating status: {err}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating order status: {ex.Message}");
        }
        finally
        {
            isUpdatingOrder = false;
        }
    }

    private string GetStatusBadgeClass(string statusName)
    {
        return statusName switch
        {
            "Pending" => "bg-warning-subtle text-warning border border-warning",
            "Confirmed" => "bg-primary-subtle text-primary border border-primary",
            "Completed" => "bg-success-subtle text-success border border-success",
            "Cancelled" => "bg-danger-subtle text-danger border border-danger",
            _ => "bg-secondary text-white"
        };
    }

    private void ShowBusinessSetup()
    {
        businessEditModel = new BusinessUpdateDTO();
        isBusinessPopupVisible = true;
    }

    private void EditBusinessProfile()
    {
        if (myBusiness == null) return;
        businessEditModel = new BusinessUpdateDTO
        {
            Id = myBusiness.Id,
            Name = myBusiness.Name,
            Description = myBusiness.Description,
            Address = myBusiness.Address,
            ImageUrl = myBusiness.ImageUrl,
            BusinessTypeId = myBusiness.BusinessTypeId,
            Latitude = myBusiness.Latitude,
            Longitude = myBusiness.Longitude
        };
        isBusinessPopupVisible = true;
    }

    private void CloseBusinessPopup()
    {
        isBusinessPopupVisible = false;
        businessEditModel = null;
    }

    private async Task SaveBusinessProfile()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage response;
            if (myBusiness == null)
            {
                response = await Http.PostAsJsonAsync("api/businesses/my-business", businessEditModel);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/businesses/{businessEditModel!.Id}", businessEditModel);
            }
            if (response.IsSuccessStatusCode)
            {
                isBusinessPopupVisible = false;
                await LoadDashboardData();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error saving business: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving business: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowPackagePopup(PackageGetDTO pkg)
    {
        packageEditModel = new PackageUpdateDTO
        {
            Id = pkg.Id,
            Name = pkg.Name,
            Description = pkg.Description,
            Price = pkg.Price,
            Quantity = pkg.Quantity,
            PickupStart = pkg.PickupStart,
            PickupEnd = pkg.PickupEnd,
            ImageUrl = pkg.ImageUrl,
            PackageTypeId = pkg.PackageTypeId,
            BusinessId = myBusiness!.Id
        };
        isPackagePopupVisible = true;
    }

    private void ClosePackagePopup()
    {
        isPackagePopupVisible = false;
        packageEditModel = null;
    }

    private async Task SavePackage()
    {
        isSaving = true;
        try
        {
            if (packageEditModel!.Id == Guid.Empty)
            {
                var createDto = new PackageCreateDTO
                {
                    Name = packageEditModel.Name,
                    Price = packageEditModel.Price,
                    Quantity = packageEditModel.Quantity,
                    PickupStart = packageEditModel.PickupStart,
                    PickupEnd = packageEditModel.PickupEnd,
                    Description = packageEditModel.Description,
                    ImageUrl = packageEditModel.ImageUrl,
                    BusinessId = packageEditModel.BusinessId,
                    PackageTypeId = packageEditModel.PackageTypeId
                };
                await Http.PostAsJsonAsync("api/packages", createDto);
            }
            else
            {
                await Http.PutAsJsonAsync($"api/packages/{packageEditModel.Id}", packageEditModel);
            }
            ClosePackagePopup();
            await LoadDashboardData();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePackage(Guid id)
    {
        await Http.DeleteAsync($"api/packages/{id}");
        await LoadDashboardData();
    }
}