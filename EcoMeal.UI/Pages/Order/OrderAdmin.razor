@page "/admin/orders"
@using EcoMeal.Shared.DTOs.OrderDTOs
@using EcoMeal.Shared.DTOs.BusinessDTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Admin - Orders</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0">Order Management</h1>
            <p class="text-muted">View all platform orders, inspect item details, and update or delete orders.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Controls -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-light">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var filter in new[] { "All", "Pending", "Confirmed", "Completed", "Cancelled" })
                    {
                        var count = filter == "All" ? orders.Count : orders.Count(o => o.StatusName == filter);
                        <button class="btn btn-sm @(selectedStatusFilter == filter ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                @onclick="() => selectedStatusFilter = filter">
                            @filter (@count)
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" @bind="selectedBusinessFilter">
                    <option value="@Guid.Empty">All Businesses</option>
                    @foreach (var b in businesses)
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search order #..." @bind="searchTerm" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        var filteredOrders = orders
            .Where(o => selectedStatusFilter == "All" || o.StatusName == selectedStatusFilter)
            .Where(o => selectedBusinessFilter == Guid.Empty || o.BusinessId == selectedBusinessFilter)
            .Where(o => string.IsNullOrWhiteSpace(searchTerm) || o.OrderNumber.ToString().Contains(searchTerm.Trim()) || o.BusinessName.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

        @if (!filteredOrders.Any())
        {
            <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>No orders found</h5>
                <p class="small">Try changing your filters or search terms.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var order in filteredOrders)
                {
                    <div class="card border shadow-sm rounded-3">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="fw-bold fs-5 me-3">Order #@order.OrderNumber</span>
                                <span class="badge bg-light text-dark border me-2">
                                    <i class="bi bi-shop me-1 text-primary"></i>@order.BusinessName
                                </span>
                                <span class="text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i>@order.BusinessAddress
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge px-3 py-2 rounded-pill fw-semibold @GetStatusBadgeClass(order.StatusName)">
                                    @order.StatusName
                                </span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOrder(order.Id)" title="Delete Order">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <ul class="list-group list-group-flush mb-2">
                                @foreach (var item in order.OrderPackages)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 bg-transparent">
                                        <div style="flex: 2;">
                                            <span class="fw-semibold text-dark">@item.PackageName</span>
                                            <span class="badge bg-secondary ms-2">x @item.Quantity</span>
                                        </div>
                                        <div class="text-muted small text-center" style="flex: 2;">
                                            <i class="bi bi-clock me-1"></i>Pickup: @item.PickupStart.ToString("HH:mm") - @item.PickupEnd.ToString("HH:mm")
                                        </div>
                                        <div class="fw-bold text-dark text-end" style="flex: 1;">
                                            @((item.PackagePrice * item.Quantity).ToString("0.00")) RON
                                        </div>
                                    </li>
                                }
                            </ul>

                            <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">User ID: <code class="text-secondary">@order.UserId</code></span>
                                <div>
                                    <span class="fw-bold text-muted me-2">Total:</span>
                                    <span class="fw-bold text-success fs-5">
                                        @((order.OrderPackages.Sum(op => op.PackagePrice * op.Quantity)).ToString("0.00")) RON
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-light border-top d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted small fw-semibold">Update Status:</span>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm @(order.StatusName == "Pending" ? "btn-warning fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => UpdateOrderStatus(order, "Pending")' disabled="@isUpdating">
                                    Pending
                                </button>
                                <button class="btn btn-sm @(order.StatusName == "Confirmed" ? "btn-primary fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => UpdateOrderStatus(order, "Confirmed")' disabled="@isUpdating">
                                    Confirmed
                                </button>
                                <button class="btn btn-sm @(order.StatusName == "Completed" ? "btn-success fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => UpdateOrderStatus(order, "Completed")' disabled="@isUpdating">
                                    Completed
                                </button>
                                <button class="btn btn-sm @(order.StatusName == "Cancelled" ? "btn-danger fw-bold" : "btn-outline-secondary")"
                                        @onclick='() => UpdateOrderStatus(order, "Cancelled")' disabled="@isUpdating">
                                    Cancelled
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<OrderGetDTO> orders = new();
    private List<BusinessGetDTO> businesses = new();
    private bool isLoading = true;
    private bool isUpdating = false;
    private string? errorMessage;

    private string selectedStatusFilter = "All";
    private Guid selectedBusinessFilter = Guid.Empty;
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            businesses = await Http.GetFromJsonAsync<List<BusinessGetDTO>>("api/businesses") ?? new();
            orders = await Http.GetFromJsonAsync<List<OrderGetDTO>>("api/orders") ?? new();
            orders = orders.OrderByDescending(o => o.OrderNumber).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading orders: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateOrderStatus(OrderGetDTO order, string newStatus)
    {
        if (order.StatusName == newStatus) return;

        var statusId = newStatus switch
        {
            "Pending" => Guid.Parse("E2712CD8-CD80-4F27-9711-C676F84E339C"),
            "Confirmed" => Guid.Parse("45B77ECA-EFE4-4A2E-867D-7EB6170D3703"),
            "Completed" => Guid.Parse("24FEB601-B7FA-4E23-AA03-F121FAD19347"),
            "Cancelled" => Guid.Parse("224F9B84-E878-4B04-BFB9-6BC6B3EBA8DD"),
            _ => Guid.Empty
        };

        if (statusId == Guid.Empty) return;

        isUpdating = true;
        try
        {
            var updateDto = new OrderUpdateDTO
            {
                Id = order.Id,
                UserId = order.UserId,
                BusinessId = order.BusinessId,
                StatusId = statusId,
                OrderNumber = order.OrderNumber
            };

            var response = await Http.PutAsJsonAsync($"api/orders/{order.Id}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                await LoadOrdersAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating order: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task DeleteOrder(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/orders/{id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadOrdersAsync();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting order: {ex.Message}";
        }
    }

    private string GetStatusBadgeClass(string statusName)
    {
        return statusName switch
        {
            "Pending" => "bg-warning-subtle text-warning border border-warning",
            "Confirmed" => "bg-primary-subtle text-primary border border-primary",
            "Completed" => "bg-success-subtle text-success border border-success",
            "Cancelled" => "bg-danger-subtle text-danger border border-danger",
            _ => "bg-secondary text-white"
        };
    }
}
